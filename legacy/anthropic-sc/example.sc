// Anthropic.sc examples: evaluate each block with Cmd-Enter, in order.
// Replies print in the post window after a few seconds.

// 1. text back
Anthropic.complete("say hello", { |r| if(r.hasError) { r.postln } { r.getText.postln } });

// 2. code extraction: prints only the code, no ``` fences
Anthropic.generateCode("a function that multiplies 2 numbers. no examples of use", action: { |r| r.getExecutableCode(0).postln });

// 3. write into the open document: code appears at the bottom under "// Generated by Claude"
Anthropic.appendToCurrentDocument("a short FM bell SynthDef with a Synth call to play it");


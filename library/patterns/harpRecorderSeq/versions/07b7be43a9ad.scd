// Vivaldi, "Spring" (La primavera, RV 269), I. Allegro, E major: the first violin's melody, the
// upbeat and bars 1-32 (the opening ritornello, the birdsong, and the start of the streams).
// Notes from the Mutopia Project's LilyPond edition (mutopiaproject.org, piece 301, CC BY-SA 3.0).
// Each note is [midinote, beats] or [midinote, beats, 1] for a trill; \rest is a rest. A trill
// plays as a Baroque trill: 32nds alternating with the next note up the E major scale, starting
// on the upper note. The upbeat plays once (after a rest, so bar 1 lands on a bar line), then
// bars 1-32 loop.
var bars = [
	[[76, 0.5]],   // 0
	[[80, 0.5], [80, 0.5], [80, 0.5], [78, 0.25], [76, 0.25], [83, 1.5], [83, 0.25], [81, 0.25]],   // 1
	[[80, 0.5], [80, 0.5], [80, 0.5], [78, 0.25], [76, 0.25], [83, 1.5], [83, 0.25], [81, 0.25]],   // 2
	[[80, 0.5], [81, 0.25], [83, 0.25], [81, 0.5], [80, 0.5], [78, 0.5], [75, 0.5], [71, 0.5], [76, 0.5]],   // 3
	[[80, 0.5], [80, 0.5], [80, 0.5], [78, 0.25], [76, 0.25], [83, 1.5], [83, 0.25], [81, 0.25]],   // 4
	[[80, 0.5], [80, 0.5], [80, 0.5], [78, 0.25], [76, 0.25], [83, 1.5], [83, 0.25], [81, 0.25]],   // 5
	[[80, 0.5], [81, 0.25], [83, 0.25], [81, 0.5], [80, 0.5], [78, 1], [\rest, 0.5], [76, 0.5]],   // 6
	[[83, 0.5], [81, 0.25], [80, 0.25], [81, 0.5], [83, 0.5], [85, 0.5], [83, 1], [76, 0.5]],   // 7
	[[83, 0.5], [81, 0.25], [80, 0.25], [81, 0.5], [83, 0.5], [85, 0.5], [83, 1], [76, 0.5]],   // 8
	[[85, 0.5], [83, 1], [81, 0.5], [80, 0.5], [78, 0.25], [76, 0.25], [78, 1, 1]],   // 9
	[[76, 1], [\rest, 0.5], [76, 0.5], [83, 0.5], [81, 0.25], [80, 0.25], [81, 0.5], [83, 0.5]],   // 10
	[[85, 0.5], [83, 1], [76, 0.5], [83, 0.5], [81, 0.25], [80, 0.25], [81, 0.5], [83, 0.5]],   // 11
	[[85, 0.5], [83, 1], [76, 0.5], [85, 0.5], [83, 1], [81, 0.5]],   // 12
	[[80, 0.5], [78, 0.25], [76, 0.25], [78, 1, 1], [76, 1], [\rest, 1]],   // 13
	[[\rest, 4]],   // 14
	[[\rest, 2], [83, 1], [83, 1]],   // 15
	[[83, 1], [83, 1], [83, 1], [83, 1]],   // 16
	[[83, 0.5], [83, 0.5], [83, 0.5], [83, 0.5], [83, 0.5], [83, 0.5], [83, 0.5], [83, 0.5]],   // 17
	[[83, 0.5], [83, 0.5], [83, 0.5], [83, 0.5], [83, 0.5], [83, 0.5], [83, 0.5], [85, 0.25], [87, 0.25]],   // 18
	[[88, 0.25], [87, 0.25], [85, 0.25], [83, 0.25], [81, 0.25], [80, 0.25], [78, 0.25], [76, 0.25], [\rest, 1], [\rest, 0.5], [88, 0.5]],   // 19
	[[88, 0.5], [88, 0.5], [88, 0.5], [88, 0.5], [76, 1.5, 1], [88, 0.5]],   // 20
	[[88, 0.5], [88, 0.5], [88, 0.5], [88, 0.5], [76, 1, 1], [80, 1, 1]],   // 21
	[[\rest, 1], [80, 1, 1], [\rest, 1], [80, 1, 1]],   // 22
	[[\rest, 1], [80, 1, 1], [83, 1.25], [88, 0.25], [83, 0.25], [85, 0.25]],   // 23
	[[83, 1.25], [88, 0.25], [83, 0.25], [85, 0.25], [83, 0.25], [88, 0.25], [83, 0.25], [85, 0.25], [83, 0.25], [88, 0.25], [83, 0.25], [85, 0.25]],   // 24
	[[83, 0.25], [88, 0.25], [83, 0.25], [85, 0.25], [83, 0.25], [88, 0.25], [83, 0.25], [85, 0.25], [83, 0.5], [76, 0.5], [\rest, 1]],   // 25
	[[88, 1], [88, 1], [88, 2, 1]],   // 26
	[[88, 1], [88, 1], [88, 1, 1], [\rest, 0.5], [76, 0.5]],   // 27
	[[83, 0.5], [81, 0.25], [80, 0.25], [81, 0.5], [83, 0.5], [85, 0.5], [83, 1], [76, 0.5]],   // 28
	[[83, 0.5], [81, 0.25], [80, 0.25], [81, 0.5], [83, 0.5], [85, 0.5], [83, 1], [76, 0.5]],   // 29
	[[85, 0.5], [83, 1], [81, 0.5], [80, 0.5], [78, 0.25], [76, 0.25], [78, 1, 1]],   // 30
	[[76, 0.5], [68, 0.25], [69, 0.25], [71, 0.25], [69, 0.25], [71, 0.25], [69, 0.25], [68, 0.25], [69, 0.25], [68, 0.25], [69, 0.25], [71, 0.25], [69, 0.25], [71, 0.25], [69, 0.25]],   // 31
	[[68, 0.25], [69, 0.25], [68, 0.25], [69, 0.25], [71, 0.25], [69, 0.25], [71, 0.25], [69, 0.25], [68, 0.25], [69, 0.25], [68, 0.25], [69, 0.25], [71, 0.25], [73, 0.25], [71, 0.25], [73, 0.25]],   // 32
];
var up = { |m| var pcs = [4, 6, 8, 9, 11, 1, 3], i = pcs.indexOf(m % 12);
	m + ((pcs.wrapAt(i + 1) - pcs[i]) % 12) };
var expand = { |n|
	if (n[0] == \rest or: { n[2] != 1 }) { [n.keep(2)] } {
		(n[1] / 0.125).round.asInteger.collect { |i| [if (i.even) { up.(n[0]) } { n[0] }, 0.125] }
	}
};
var notes = { |bs| bs.collect { |b| b.collect(expand).flatten(1) }.flatten(1) };
Pbind(
	\instrument, \harpRecorder,
	[\midinote, \dur], Pseq([Pseq([[\rest, 3.5]] ++ notes.(bars.keep(1))), Pseq(notes.(bars.drop(1)), inf)]),
	\legato, 0.9,
	\amp, 0.3,
	\bar, 4
)

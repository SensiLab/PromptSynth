// Bach, Prelude in C major BWV 846 (WTC I): each bar's five-note chord broken as
// 1 2 3 4 5 3 4 5, twice per bar, in 16ths. Bars 33-34 written out, bar 35 the final chord.
(
var bars = [
	[60, 64, 67, 72, 76], [60, 62, 69, 74, 77], [59, 62, 67, 74, 77], [60, 64, 67, 72, 76],
	[60, 64, 69, 76, 81], [60, 62, 66, 69, 74], [59, 62, 67, 74, 79], [59, 60, 64, 67, 72],
	[57, 60, 64, 67, 72], [50, 57, 62, 66, 72], [55, 59, 62, 67, 71], [55, 58, 64, 67, 73],
	[53, 57, 62, 69, 74], [53, 56, 62, 65, 71], [52, 55, 60, 67, 72], [52, 53, 57, 60, 65],
	[50, 53, 57, 60, 65], [43, 50, 55, 59, 65], [48, 52, 55, 60, 64], [48, 55, 58, 60, 64],
	[41, 53, 57, 60, 64], [42, 48, 57, 60, 63], [44, 53, 59, 60, 62], [43, 53, 55, 59, 62],
	[43, 52, 55, 60, 64], [43, 50, 55, 60, 65], [43, 50, 55, 59, 65], [43, 51, 57, 60, 66],
	[43, 52, 55, 60, 67], [43, 50, 55, 60, 65], [43, 50, 55, 59, 65], [36, 48, 55, 58, 64]
];
var notes = bars.collect { |c| [c[0], c[1], c[2], c[3], c[4], c[2], c[3], c[4]] ! 2 }.flat
	++ [36, 48, 53, 57, 60, 65, 60, 57, 60, 57, 53, 57, 53, 50, 53, 50]   // bar 33
	++ [36, 47, 67, 71, 74, 77, 74, 71, 74, 71, 67, 71, 62, 65, 64, 62]   // bar 34
	++ [[36, 48, 64, 67, 72]];                                             // bar 35
var accents = [1, 0.7, 0.75, 0.8, 0.85, 0.7, 0.75, 0.8];
Pbind(
	\instrument, \fmSweep,
	\note, Pseq(notes - 60, inf),
	\dur, Pseq((0.25 ! (34 * 16)) ++ [4], inf),
	\amp, Pseq((accents ! (34 * 2)).flat ++ [0.9], inf) * 0.16,
	\legato, Pseq((1.6 ! (34 * 16)) ++ [1], inf),
	\bar, 4
)
)
